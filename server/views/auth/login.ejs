<% include ../partials/header %>
<% include ../partials/main_nav %>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">

      <div class="login-card">

        <h2 class="text-center mb-4">Login to Assignment Tracker</h2>

        <p class="subtitle text-center mb-4">
          Sign in with one of the providers below to manage your assignments.
        </p>

        <div class="d-grid gap-3 mb-3">

          <!-- Google Button -->
          <a href="/auth/google" class="login-provider-btn">
            <i class="fab fa-google"></i>
            Continue with Google
          </a>

          <!-- GitHub Button -->
          <a href="/auth/github" class="login-provider-btn">
            <i class="fab fa-github"></i>
            Continue with GitHub
          </a>

        </div>

        <p class="login-note text-center">
          You will only be able to create, edit, and delete assignments when logged in.
        </p>

      </div>

    </div>
  </div>
</div>

<% include ../partials/footer %>
